# ╔══════════════════════════════════════════╗
# ║      JARVIS - Configuration (.env)       ║
# ╚══════════════════════════════════════════╝
# Copier ce fichier en .env et remplir les valeurs

# ──────────────────────────────
# LLM Actif par défaut
# ──────────────────────────────
# Choix: claude | openai | grok | kimi
JARVIS_LLM=claude

# ──────────────────────────────
# Clés API LLM
# ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...       # https://console.anthropic.com
OPENAI_API_KEY=sk-...              # https://platform.openai.com
GROK_API_KEY=xai-...               # https://console.x.ai
KIMI_API_KEY=sk-...                # https://platform.moonshot.cn

# ──────────────────────────────
# Modèles (optionnel)
# ──────────────────────────────
CLAUDE_MODEL=claude-opus-4-6
OPENAI_MODEL=gpt-4o
GROK_MODEL=grok-3
KIMI_MODEL=moonshot-v1-8k

# ──────────────────────────────
# Telegram
# ──────────────────────────────
# Token du bot (obtenu via @BotFather sur Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# IDs Telegram autorisés (séparés par virgule, vide = tous autorisés)
# Obtenir votre ID: écrire à @userinfobot sur Telegram
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ──────────────────────────────
# Fonctionnalités Hardware (Raspberry Pi)
# ──────────────────────────────
ENABLE_GPIO=false       # Activer le contrôle GPIO
ENABLE_CAMERA=false     # Activer la caméra Pi
ENABLE_AUDIO=false      # Activer l'audio (TTS)

# ──────────────────────────────
# Sécurité
# ──────────────────────────────
# ⚠️ ATTENTION: Permet d'exécuter des commandes shell via Telegram
ENABLE_SHELL=false
