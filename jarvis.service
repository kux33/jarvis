[Unit]
Description=JARVIS AI Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jarvis
EnvironmentFile=/home/pi/jarvis/.env
ExecStart=/home/pi/jarvis/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
